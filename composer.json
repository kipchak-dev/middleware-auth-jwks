{
    "name": "kipchak/middleware-auth-jwks",
    "type": "middleware",
    "description": "The Official JWKS Auth Middleware for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "HTTP",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Middleware\\Auth\\JWKS\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "firebase/php-jwt": "^7",
        "kipchak/core": "^2",
        "kipchak/driver-config": "^1",
        "kipchak/driver-logger": "^1",
        "kipchak/driver-filecache": "^1"
    }
}
